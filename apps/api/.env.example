# AtlasForecast API — configuration reference.
# Copy to .env and fill in real values. NEVER commit .env.

# --- Server ---
# AtlasForecast runs on 4001. Port 4000 belongs to a different local project.
PORT=4001
NODE_ENV=development

# --- CORS (Priority 4) ---
# Comma-separated list of allowed browser origins.
# In development the local Vite origins (5173/4173) are always allowed and this
# may be left empty. In PRODUCTION this is REQUIRED — the API refuses to start
# with an empty allowlist, and no wildcard is ever used.
CORS_ORIGINS=https://atlasforecast.example.com

# --- Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Service-role key. STRONGLY RECOMMENDED.
# Without it the API writes premium entitlement using the same publishable key
# the browser holds, so the database cannot distinguish an API write from a
# browser write. With it, RLS can deny writes to profiles.is_premium /
# profiles.plan_name for everyone except the server.
# This key bypasses RLS — server-side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (premium activation) ---
# When STRIPE_SECRET_KEY is unset, POST /billing/checkout returns 503 and no
# premium entitlement can be activated by any route. This is intentional:
# an unconfigured payment provider must not be able to look like a paid one.
STRIPE_SECRET_KEY=

# REQUIRED for POST /billing/webhook to do anything. Without it the webhook
# rejects every request with 503 rather than trusting an unsigned body.
STRIPE_WEBHOOK_SECRET=

# --- Weather (OpenWeather API) ---
OPENWEATHER_API_KEY=
OPENWEATHER_BASE_URL=https://api.openweathermap.org
WEATHER_API_KEY=

# --- Paddle Billing (Preferred SaaS Provider) ---
# API Key from Paddle Dashboard > Developer Tools > Authentication
PADDLE_API_KEY=
# Webhook Secret from Paddle Dashboard > Developer Tools > Notifications
PADDLE_WEBHOOK_SECRET=
# Environment: 'sandbox' (default for development) or 'production'
PADDLE_ENVIRONMENT=sandbox

# --- Optional integrations ---
GEMINI_API_KEY=
RESEND_API_KEY=
